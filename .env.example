# ====== Neon (PostgreSQL) ======
# Ces 2 variables sont injectées automatiquement par l'intégration
# Neon-Vercel en production. En local, copie-les depuis Vercel
# (Project Settings → Environment Variables → "Pull" vers .env.local)
# OU depuis le dashboard Neon (Connection Details).
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-xxx.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ====== NextAuth (Auth.js) ======
# openssl rand -base64 32
AUTH_SECRET="change-me"
# En local : http://localhost:3000  — en prod : ton URL Vercel
AUTH_URL="http://localhost:3000"
# Trust le host pour les preview deployments Vercel
AUTH_TRUST_HOST="true"

# ====== GitHub OAuth ======
# https://github.com/settings/developers -> New OAuth App
# Authorization callback URL : http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
